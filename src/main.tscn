[node name="ValentineBreakfast" type="Node3D" parent="." unique_id=1812547196 node_paths=PackedStringArray("svp")]
script = ExtResource("9_srxbw")
svp = NodePath("../BreakfastSVP")
alias = "Valentine's Breakfast"
time = "1643-02-14T06:00"
transcript = "{Robert}:
Be my valentine?

{Sofia}:
You already know I will.

{Margaret}:
Guys, I love you, and it was cute at first, but you gotta get a room.

{Robert}:
Good point. Sof, my room. After work. 8pm.

{Margaret}:
(Groans)"

