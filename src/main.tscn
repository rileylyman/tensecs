[node name="ChristmasParty" type="Node3D" parent="." unique_id=1430046907 node_paths=PackedStringArray("svp")]
script = ExtResource("9_srxbw")
svp = NodePath("../BreakroomSVP")
alias = "Christmas Party"
time = "1642-12-25T19:00"
transcript = "{Robert}:
Thanks for the invite, y'all.

{Sofia}:
Of course. Though... I heard you on the phone a bit earlier.

{Robert}:
What? When?

{Margaret}
She happened to be passing by your room, 5 minutes ago.

Listen, I like you, but if it turns out you've been leading her on, hiding a partner back at home, I'll kill you.

{Robert}:
(Chuckles) Don't worry, it's not like that.

{Margaret}:
Good. You'd better treat her right. I expect you guys to be a power couple by Valentine's day.

{Sofia}:
Marg!

"

