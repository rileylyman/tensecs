[node name="InviteBreakfast" type="Node3D" parent="." unique_id=809477499 node_paths=PackedStringArray("svp")]
visible = false
script = ExtResource("9_srxbw")
svp = NodePath("../BreakfastSVP")
alias = "Breakfast, Christmas Eve"
time = "1642-12-24T06:00"
transcript = "{Margaret}:
So, Mr. New Guy. What convinced you to forsake society and waste away on an asteroid mine?

{Robert}:
Name's Robert. And it's personal.

{Margaret}:
Hmph. 

{Sofia}:
Hey, come along to our Christmas party tomorrow? It's at 7pm.

{Margaret}:
Sofia would be thrilled, she's been eyeing you since you got here.

{Robert}:
(Chuckles) So that's why you sat next to me...

{Sofia}
Marg! Shut up!"

