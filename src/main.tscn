alias = "Confrontation"
time = "1643-02-14T20:00"
transcript = "{Sofia}:
Please, Robert, I'll forget what I saw. Please don't do this.

{Robert}:
God dammit! It wasn't supposed to go this way. What the fuck do I do? Huh? Tell me what the fuck to do!

{Sofia}:
Robert, please!

{Robert}:
You can't just show up 30 minutes early! God-fucking-dammit!"

